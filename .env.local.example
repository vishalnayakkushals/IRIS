# Local developer runtime env (do not commit real values)
# Copy to `.env.local` and fill values.

MAX_FRAMES_PER_JOB=100
OPENAI_API_KEY=replace_with_openai_key
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_MODEL=gpt-4.1-mini

# Google
GOOGLE_API_KEY=replace_with_google_api_key
# Preferred write-access setup: point this to a downloaded service-account JSON key.
# Keep the JSON in .local-secrets/ or another private local path. Do not commit it.
GOOGLE_SERVICE_ACCOUNT_FILE=.local-secrets/google_service_account.json
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_ID=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----\n"

# On-fly pipeline defaults
ONFLY_STORE_ID=TEST_STORE_D07
ONFLY_SOURCE_URL=https://drive.google.com/drive/folders/1Wd8X8t-wF_HhPQPYuuFHjqTq6Ojc3Nnw
ONFLY_MAX_IMAGES=100
# Detector: "onnx" (default, no PyTorch needed) or "yolo" (dev machines with ultralytics installed)
ONFLY_DETECTOR=onnx
# Confidence threshold — 0.20 makes ONNX more sensitive than YOLO was at 0.30 (catches more borderline people)
YOLO_CONF=0.20

# Network access — add your local IP so teammates on the same network can access the app
# Example: http://192.168.1.113:8767
# CORS_ORIGINS=http://localhost:3000,http://localhost:8767,http://127.0.0.1:8767,http://192.168.1.113:8767
