[Unit]
Description=IRIS Streamlit Web Dashboard
Documentation=https://github.com/your-org/iris
After=network.target iris-api.service

[Service]
Type=simple
User=iris
Group=iris
WorkingDirectory=/opt/iris/app

# Load production secrets from shared env file
EnvironmentFile=/opt/iris/shared/iris.env
Environment=IRIS_ENV_FILE=/opt/iris/shared/iris.env
Environment=PYTHONPATH=/opt/iris/app:/opt/iris/app/src
Environment=STREAMLIT_SERVER_HEADLESS=true
Environment=IRIS_STREAMLIT_HOST=0.0.0.0
Environment=IRIS_STREAMLIT_PORT=8765

ExecStart=/opt/iris/app/.venv/bin/python /opt/iris/app/scripts/start_web_app.py

# Graceful stop
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

Restart=always
RestartSec=5

# Logging to systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=iris-web

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/iris/data /opt/iris/shared

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
