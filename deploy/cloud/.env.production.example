# =============================================================================
# IRIS Production Environment Template
# Copy to /opt/iris/shared/iris.env and fill values before starting services.
#
#   sudo cp .env.production.example /opt/iris/shared/iris.env
#   sudo nano /opt/iris/shared/iris.env
#   sudo chmod 640 /opt/iris/shared/iris.env
#   sudo chown iris:iris /opt/iris/shared/iris.env
# =============================================================================

# ── Postgres (required) ───────────────────────────────────────────────────────
# asyncpg driver for async FastAPI stack
POSTGRES_URL=postgresql+asyncpg://iris_user:CHANGE_ME@localhost/iris_db

# Sync URL for schema bootstrap and admin scripts
POSTGRES_SYNC_URL=postgresql+psycopg2://iris_user:CHANGE_ME@localhost/iris_db

# Connection pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30

# ── JWT (required) ────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_HEX
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── External API Keys ─────────────────────────────────────────────────────────
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ── IRIS Runtime ──────────────────────────────────────────────────────────────
ENVIRONMENT=production
IRIS_DATA_ROOT=/opt/iris/data
API_PORT=8767
API_HOST=0.0.0.0
API_RELOAD=0

# CORS: set to the exact origin(s) your domain serves (no trailing slash)
# e.g. https://iris.kushals.com  or  https://iris.kushals.com,https://www.kushals.com
CORS_ORIGINS=https://your-domain.com

# ── Pipeline Configuration ────────────────────────────────────────────────────
STORE_ID=
ONFLY_SOURCE_URL=
YOLO_CONF=0.30
MAX_IMAGES=100
OPENAI_MODEL=gpt-4.1-mini

# ── Google Drive ──────────────────────────────────────────────────────────────
# Path to service account JSON file with Drive read access
GOOGLE_SERVICE_ACCOUNT_JSON=/opt/iris/shared/service_account.json
# Shared Drive ID (leave blank for My Drive)
GOOGLE_DRIVE_ROOT_ID=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Optional: path for file-based logs in addition to journald
# IRIS_LOG_FILE=/opt/iris/data/logs/iris.log

# ── Feature flags ─────────────────────────────────────────────────────────────
# Set to 1 to enable experimental BoT-SORT re-identification pipeline (D07)
ENABLE_BOTSORT=0
