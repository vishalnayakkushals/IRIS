# IRIS single-app no-Docker environment
# Copy to deploy/no_docker/.env.local or set IRIS_ENV_FILE to a secure path outside the repo.

# Runtime paths
IRIS_APP_DIR=/opt/iris/app
IRIS_DATA_DIR=/opt/iris/data
IRIS_STORES_ROOT=/opt/iris/data/stores
IRIS_EXPORT_DIR=/opt/iris/data/exports/current
IRIS_EMPLOYEE_ASSETS_DIR=/opt/iris/data/employee_assets

# Database
POSTGRES_URL=postgresql+asyncpg://iris_user:iris_password@127.0.0.1/iris_db
POSTGRES_SYNC_URL=postgresql+psycopg2://iris_user:iris_password@127.0.0.1/iris_db

# Web app
API_HOST=0.0.0.0
API_PORT=8767
API_RELOAD=0
JWT_SECRET=replace_with_secure_random_secret

# Secrets
GOOGLE_API_KEY=replace_with_google_api_key
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_MODEL=gpt-4.1-mini

# Core scheduler polling
IRIS_SCHEDULER_POLL_SECONDS=10
IRIS_ONFLY_POLL_SECONDS=30

# Optional feature flags
IRIS_PRELOAD_TORCH=1
IRIS_ALLOW_MOCK_DETECTOR=0
IRIS_FEEDBACK_OVERRIDE_ENABLED=1
